{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reply",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/AreaDecision"
        }
      },
      "required": [
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError"
        }
      },
      "required": [
        "error"
      ]
    }
  ],
  "required": [
    "request_id",
    "timestamp"
  ],
  "$defs": {
    "ApiError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "current_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "AreaDecision": {
      "type": "object",
      "properties": {
        "area_id": {
          "type": "string",
          "format": "uuid"
        },
        "area_revision": {
          "type": "integer",
          "format": "int64"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decision"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "area_id",
        "area_revision",
        "generation"
      ]
    },
    "Decision": {
      "type": "object",
      "properties": {
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        },
        "area_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "area_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "checkout_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "content_sha256": {
          "type": "string"
        },
        "decision_id": {
          "type": "string",
          "format": "uuid"
        },
        "generation": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "proposal_id": {
          "type": "string",
          "format": "uuid"
        },
        "proposal_revision": {
          "type": "integer",
          "format": "int64"
        },
        "selected_option": {
          "$ref": "#/$defs/ProposalOption"
        },
        "topic": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "decision_id",
        "workspace_id",
        "proposal_id",
        "proposal_revision",
        "topic",
        "selected_option",
        "content_sha256",
        "accepted_at"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "DATABASE_UNAVAILABLE",
        "INCOMPATIBLE_SCHEMA",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "INVALID_INPUT",
        "IDEMPOTENCY_CONFLICT",
        "REVISION_CONFLICT",
        "CURSOR_EXPIRED",
        "INVALID_TRANSITION",
        "DEPENDENCY_NOT_READY",
        "DEPENDENCY_CYCLE",
        "DELEGATION_CYCLE",
        "DELEGATION_LIMIT",
        "DELEGATION_INACTIVE",
        "CHECKOUT_ROOT_OVERLAP",
        "ACCESS_REQUEST_REQUIRED",
        "PATH_CLAIMED",
        "CLAIM_FENCE_STALE",
        "CLAIM_RENEWAL_LIMIT",
        "PATH_HANDOFF_PENDING",
        "BUDGET_EXHAUSTED",
        "EXECUTION_PAUSED",
        "EXECUTION_CAPACITY_REACHED",
        "MESSAGE_RATE_LIMITED",
        "ARTIFACT_QUOTA_EXCEEDED",
        "ARTIFACT_UPLOAD_OPEN",
        "ARTIFACT_INCOMPLETE",
        "ARTIFACT_DIGEST_MISMATCH",
        "ARTIFACT_UNAVAILABLE",
        "RUN_LEASE_STALE",
        "COORDINATOR_STALE",
        "CHECKOUT_OFFLINE",
        "PATH_FORBIDDEN",
        "SCOPE_STALE",
        "CONTENT_CONFLICT",
        "CONTEXT_STALE",
        "CHECKOUT_RECONCILIATION_REQUIRED",
        "PUBLICATION_PENDING",
        "FILE_NOT_FOUND",
        "NOT_FOUND"
      ]
    },
    "ProposalOption": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "description"
      ]
    }
  }
}
