{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reply",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/ActorContext"
        }
      },
      "required": [
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError"
        }
      },
      "required": [
        "error"
      ]
    }
  ],
  "required": [
    "request_id",
    "timestamp"
  ],
  "$defs": {
    "ActorContext": {
      "type": "object",
      "properties": {
        "actor": {
          "$ref": "#/$defs/Recipient"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextDiagnostic"
          }
        },
        "inbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/InboxPage"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentRole"
            },
            {
              "type": "null"
            }
          ]
        },
        "tasks": {
          "$ref": "#/$defs/ContextTasks"
        },
        "workflow": {
          "$ref": "#/$defs/WorkflowGuide"
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "workspace_id",
        "actor",
        "tasks",
        "workflow",
        "diagnostics"
      ]
    },
    "AgentRole": {
      "type": "string",
      "enum": [
        "lead",
        "worker",
        "reviewer"
      ]
    },
    "ApiError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "current_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "ContextDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "next_action": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "next_action"
      ]
    },
    "ContextTask": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "task_id",
        "revision",
        "status",
        "objective"
      ]
    },
    "ContextTasks": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextTask"
          }
        },
        "next_after": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "required": [
        "items"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "DATABASE_UNAVAILABLE",
        "INCOMPATIBLE_SCHEMA",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "INVALID_INPUT",
        "IDEMPOTENCY_CONFLICT",
        "REVISION_CONFLICT",
        "CURSOR_EXPIRED",
        "INVALID_TRANSITION",
        "DEPENDENCY_NOT_READY",
        "DEPENDENCY_CYCLE",
        "DELEGATION_CYCLE",
        "DELEGATION_LIMIT",
        "DELEGATION_INACTIVE",
        "CHECKOUT_ROOT_OVERLAP",
        "ACCESS_REQUEST_REQUIRED",
        "PATH_CLAIMED",
        "CLAIM_FENCE_STALE",
        "CLAIM_RENEWAL_LIMIT",
        "PATH_HANDOFF_PENDING",
        "BUDGET_EXHAUSTED",
        "EXECUTION_PAUSED",
        "EXECUTION_CAPACITY_REACHED",
        "MESSAGE_RATE_LIMITED",
        "ARTIFACT_QUOTA_EXCEEDED",
        "ARTIFACT_UPLOAD_OPEN",
        "ARTIFACT_INCOMPLETE",
        "ARTIFACT_DIGEST_MISMATCH",
        "ARTIFACT_UNAVAILABLE",
        "RUN_LEASE_STALE",
        "COORDINATOR_STALE",
        "CHECKOUT_OFFLINE",
        "PATH_FORBIDDEN",
        "SCOPE_STALE",
        "CONTENT_CONFLICT",
        "CONTEXT_STALE",
        "CHECKOUT_RECONCILIATION_REQUIRED",
        "PUBLICATION_PENDING",
        "FILE_NOT_FOUND",
        "NOT_FOUND"
      ]
    },
    "InboxEvent": {
      "type": "object",
      "properties": {
        "acknowledged_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "type": "string"
        },
        "payload": true
      },
      "required": [
        "event_id",
        "event_type",
        "payload",
        "created_at"
      ]
    },
    "InboxPage": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InboxEvent"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "events",
        "next_cursor",
        "has_more"
      ]
    },
    "Recipient": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "user_id"
      ]
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "assigned",
        "in_progress",
        "blocked",
        "in_review",
        "changes_requested",
        "done",
        "cancelled",
        "failed"
      ]
    },
    "WorkflowGuide": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "integer",
          "format": "int16",
          "maximum": 32767,
          "minimum": -32768
        }
      },
      "required": [
        "version",
        "steps"
      ]
    }
  }
}
