{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reply",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/ManagedInput"
        }
      },
      "required": [
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError"
        }
      },
      "required": [
        "error"
      ]
    }
  ],
  "required": [
    "request_id",
    "timestamp"
  ],
  "$defs": {
    "ApiError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "current_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "DATABASE_UNAVAILABLE",
        "INCOMPATIBLE_SCHEMA",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "INVALID_INPUT",
        "IDEMPOTENCY_CONFLICT",
        "REVISION_CONFLICT",
        "CURSOR_EXPIRED",
        "INVALID_TRANSITION",
        "DEPENDENCY_NOT_READY",
        "DEPENDENCY_CYCLE",
        "DELEGATION_CYCLE",
        "DELEGATION_LIMIT",
        "DELEGATION_INACTIVE",
        "CHECKOUT_ROOT_OVERLAP",
        "ACCESS_REQUEST_REQUIRED",
        "PATH_CLAIMED",
        "CLAIM_FENCE_STALE",
        "CLAIM_RENEWAL_LIMIT",
        "PATH_HANDOFF_PENDING",
        "BUDGET_EXHAUSTED",
        "EXECUTION_PAUSED",
        "EXECUTION_CAPACITY_REACHED",
        "MESSAGE_RATE_LIMITED",
        "ARTIFACT_QUOTA_EXCEEDED",
        "ARTIFACT_UPLOAD_OPEN",
        "ARTIFACT_INCOMPLETE",
        "ARTIFACT_DIGEST_MISMATCH",
        "ARTIFACT_UNAVAILABLE",
        "RUN_LEASE_STALE",
        "COORDINATOR_STALE",
        "CHECKOUT_OFFLINE",
        "PATH_FORBIDDEN",
        "SCOPE_STALE",
        "CONTENT_CONFLICT",
        "CONTEXT_STALE",
        "CHECKOUT_RECONCILIATION_REQUIRED",
        "PUBLICATION_PENDING",
        "FILE_NOT_FOUND",
        "NOT_FOUND"
      ]
    },
    "ManagedInput": {
      "type": "object",
      "properties": {
        "answer": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkpoint_id": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "question": {
          "type": "string"
        },
        "requester": {
          "$ref": "#/$defs/Recipient"
        },
        "respondent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recipient"
            },
            {
              "type": "null"
            }
          ]
        },
        "resumed_job_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "$ref": "#/$defs/ManagedInputState"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "task_id",
        "run_id",
        "requester",
        "checkpoint_id",
        "question",
        "state",
        "expires_at"
      ]
    },
    "ManagedInputState": {
      "type": "string",
      "enum": [
        "waiting",
        "answered",
        "expired",
        "cancelled"
      ]
    },
    "Recipient": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "user_id"
      ]
    }
  }
}
