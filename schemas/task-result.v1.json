{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reply",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/TaskResult"
        }
      },
      "required": [
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError"
        }
      },
      "required": [
        "error"
      ]
    }
  ],
  "required": [
    "request_id",
    "timestamp"
  ],
  "$defs": {
    "AgentReportedCheck": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ReportedCheckOutcome"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "outcome",
        "notes"
      ]
    },
    "ApiError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "current_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "ArtifactFormat": {
      "type": "string",
      "enum": [
        "text",
        "json",
        "diff"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "DATABASE_UNAVAILABLE",
        "INCOMPATIBLE_SCHEMA",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "INVALID_INPUT",
        "IDEMPOTENCY_CONFLICT",
        "REVISION_CONFLICT",
        "CURSOR_EXPIRED",
        "INVALID_TRANSITION",
        "DEPENDENCY_NOT_READY",
        "DEPENDENCY_CYCLE",
        "DELEGATION_CYCLE",
        "DELEGATION_LIMIT",
        "DELEGATION_INACTIVE",
        "CHECKOUT_ROOT_OVERLAP",
        "ACCESS_REQUEST_REQUIRED",
        "PATH_CLAIMED",
        "CLAIM_FENCE_STALE",
        "CLAIM_RENEWAL_LIMIT",
        "PATH_HANDOFF_PENDING",
        "BUDGET_EXHAUSTED",
        "EXECUTION_PAUSED",
        "EXECUTION_CAPACITY_REACHED",
        "MESSAGE_RATE_LIMITED",
        "ARTIFACT_QUOTA_EXCEEDED",
        "ARTIFACT_UPLOAD_OPEN",
        "ARTIFACT_INCOMPLETE",
        "ARTIFACT_DIGEST_MISMATCH",
        "ARTIFACT_UNAVAILABLE",
        "RUN_LEASE_STALE",
        "COORDINATOR_STALE",
        "CHECKOUT_OFFLINE",
        "PATH_FORBIDDEN",
        "SCOPE_STALE",
        "CONTENT_CONFLICT",
        "CONTEXT_STALE",
        "CHECKOUT_RECONCILIATION_REQUIRED",
        "PUBLICATION_PENDING",
        "FILE_NOT_FOUND",
        "NOT_FOUND"
      ]
    },
    "Recipient": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "user_id"
      ]
    },
    "ReportedCheckOutcome": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "skipped",
        "unknown"
      ]
    },
    "ResultArtifact": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/ArtifactFormat"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "format",
        "content",
        "content_sha256"
      ]
    },
    "ResultBinding": {
      "type": "object",
      "properties": {
        "criteria_revision": {
          "type": "integer",
          "format": "int64"
        },
        "criteria_sha256": {
          "type": "string"
        },
        "result_revision": {
          "type": "integer",
          "format": "int64"
        },
        "result_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "result_revision",
        "result_sha256",
        "criteria_revision",
        "criteria_sha256"
      ]
    },
    "ResultReview": {
      "type": "object",
      "properties": {
        "decision": {
          "$ref": "#/$defs/ReviewDecision"
        },
        "reason": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewer": {
          "$ref": "#/$defs/Recipient"
        }
      },
      "required": [
        "reviewer",
        "decision",
        "reason",
        "reviewed_at"
      ]
    },
    "ReviewDecision": {
      "type": "string",
      "enum": [
        "accept",
        "request_changes"
      ]
    },
    "TaskResult": {
      "type": "object",
      "properties": {
        "author": {
          "$ref": "#/$defs/Recipient"
        },
        "binding": {
          "$ref": "#/$defs/ResultBinding"
        },
        "content": {
          "$ref": "#/$defs/TaskResultContent"
        },
        "result_id": {
          "type": "string",
          "format": "uuid"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultReview"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "submitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "result_id",
        "workspace_id",
        "task_id",
        "run_id",
        "author",
        "binding",
        "content",
        "submitted_at"
      ]
    },
    "TaskResultContent": {
      "type": "object",
      "properties": {
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agent_reported_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentReportedCheck"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResultArtifact"
          }
        },
        "criteria_revision": {
          "type": "integer",
          "format": "int64"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "summary",
        "criteria_revision",
        "acceptance_criteria",
        "artifacts",
        "agent_reported_checks"
      ]
    }
  }
}
