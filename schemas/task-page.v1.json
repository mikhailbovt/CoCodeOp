{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reply",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/TaskPage"
        }
      },
      "required": [
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError"
        }
      },
      "required": [
        "error"
      ]
    }
  ],
  "required": [
    "request_id",
    "timestamp"
  ],
  "$defs": {
    "ApiError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "current_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "DATABASE_UNAVAILABLE",
        "INCOMPATIBLE_SCHEMA",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "INVALID_INPUT",
        "IDEMPOTENCY_CONFLICT",
        "REVISION_CONFLICT",
        "CURSOR_EXPIRED",
        "INVALID_TRANSITION",
        "DEPENDENCY_NOT_READY",
        "DEPENDENCY_CYCLE",
        "DELEGATION_CYCLE",
        "DELEGATION_LIMIT",
        "DELEGATION_INACTIVE",
        "CHECKOUT_ROOT_OVERLAP",
        "ACCESS_REQUEST_REQUIRED",
        "PATH_CLAIMED",
        "CLAIM_FENCE_STALE",
        "CLAIM_RENEWAL_LIMIT",
        "PATH_HANDOFF_PENDING",
        "BUDGET_EXHAUSTED",
        "EXECUTION_PAUSED",
        "EXECUTION_CAPACITY_REACHED",
        "MESSAGE_RATE_LIMITED",
        "ARTIFACT_QUOTA_EXCEEDED",
        "ARTIFACT_UPLOAD_OPEN",
        "ARTIFACT_INCOMPLETE",
        "ARTIFACT_DIGEST_MISMATCH",
        "ARTIFACT_UNAVAILABLE",
        "RUN_LEASE_STALE",
        "COORDINATOR_STALE",
        "CHECKOUT_OFFLINE",
        "PATH_FORBIDDEN",
        "SCOPE_STALE",
        "CONTENT_CONFLICT",
        "CONTEXT_STALE",
        "CHECKOUT_RECONCILIATION_REQUIRED",
        "PUBLICATION_PENDING",
        "FILE_NOT_FOUND",
        "NOT_FOUND"
      ]
    },
    "Recipient": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "user_id"
      ]
    },
    "ReviewPolicy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "accountable"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "explicit_reviewer"
            },
            "reviewer": {
              "$ref": "#/$defs/Recipient"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "reviewer"
          ]
        }
      ]
    },
    "Subject": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "human"
            },
            "user_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "user_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "type": "string",
              "const": "agent"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "agent_id"
          ]
        }
      ]
    },
    "Task": {
      "type": "object",
      "properties": {
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_criteria_revision": {
          "type": "integer",
          "format": "int64",
          "default": 1
        },
        "accountable": {
          "$ref": "#/$defs/Subject"
        },
        "assignee": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recipient"
            },
            {
              "type": "null"
            }
          ]
        },
        "author": {
          "$ref": "#/$defs/Subject"
        },
        "block_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskBlockReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "delegation_grant_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TaskDependency"
          }
        },
        "execution": {
          "$ref": "#/$defs/TaskExecution"
        },
        "objective": {
          "type": "string"
        },
        "owner_user_id": {
          "type": "string",
          "format": "uuid"
        },
        "parent_task_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "review_policy": {
          "$ref": "#/$defs/ReviewPolicy"
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "team_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "task_id",
        "workspace_id",
        "owner_user_id",
        "author",
        "accountable",
        "status",
        "revision",
        "objective",
        "acceptance_criteria",
        "execution",
        "review_policy",
        "dependencies",
        "created_at",
        "updated_at"
      ]
    },
    "TaskBlockReason": {
      "type": "string",
      "enum": [
        "awaiting_owner",
        "review_escalation"
      ]
    },
    "TaskDependency": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "task_id",
        "status"
      ]
    },
    "TaskExecution": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "coordination"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "checkout_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "kind": {
              "type": "string",
              "const": "coding"
            },
            "work_scope_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "work_scope_revision": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "TaskPage": {
      "type": "object",
      "properties": {
        "next_after": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Task"
          }
        }
      },
      "required": [
        "tasks"
      ]
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "assigned",
        "in_progress",
        "blocked",
        "in_review",
        "changes_requested",
        "done",
        "cancelled",
        "failed"
      ]
    }
  }
}
