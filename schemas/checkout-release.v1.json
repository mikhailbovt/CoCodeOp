{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reply",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/CheckoutRelease"
        }
      },
      "required": [
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError"
        }
      },
      "required": [
        "error"
      ]
    }
  ],
  "required": [
    "request_id",
    "timestamp"
  ],
  "$defs": {
    "ApiError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "current_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "CheckoutContentHead": {
      "type": "object",
      "properties": {
        "checkout_revision": {
          "type": "integer",
          "format": "int64"
        },
        "source_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "checkout_revision",
        "source_sha256"
      ]
    },
    "CheckoutRelease": {
      "type": "object",
      "properties": {
        "approved_changes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "authorization_sha256": {
          "type": "string"
        },
        "checkout_id": {
          "type": "string",
          "format": "uuid"
        },
        "command_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "finalized_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "head": {
          "$ref": "#/$defs/CheckoutContentHead"
        },
        "host_runner_id": {
          "type": "string",
          "format": "uuid"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckoutReleaseOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_revision": {
          "type": "integer",
          "format": "int64"
        },
        "release_id": {
          "type": "string",
          "format": "uuid"
        },
        "snapshot_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "$ref": "#/$defs/CheckoutReleaseState"
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "workspace_id",
        "checkout_id",
        "release_id",
        "snapshot_id",
        "host_runner_id",
        "head",
        "policy_revision",
        "authorization_sha256",
        "approved_changes",
        "command_ids",
        "state"
      ]
    },
    "CheckoutReleaseOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "commit_sha256": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "accepted"
            },
            "tree_sha256": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "commit_sha256",
            "tree_sha256"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "source_changed"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ref_conflict"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "storage_unavailable"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "CheckoutReleaseState": {
      "type": "string",
      "enum": [
        "queued",
        "applying",
        "accepted",
        "source_changed",
        "ref_conflict",
        "storage_unavailable",
        "expired"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "DATABASE_UNAVAILABLE",
        "INCOMPATIBLE_SCHEMA",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "INVALID_INPUT",
        "IDEMPOTENCY_CONFLICT",
        "REVISION_CONFLICT",
        "CURSOR_EXPIRED",
        "INVALID_TRANSITION",
        "DEPENDENCY_NOT_READY",
        "DEPENDENCY_CYCLE",
        "DELEGATION_CYCLE",
        "DELEGATION_LIMIT",
        "DELEGATION_INACTIVE",
        "CHECKOUT_ROOT_OVERLAP",
        "ACCESS_REQUEST_REQUIRED",
        "PATH_CLAIMED",
        "CLAIM_FENCE_STALE",
        "CLAIM_RENEWAL_LIMIT",
        "PATH_HANDOFF_PENDING",
        "BUDGET_EXHAUSTED",
        "EXECUTION_PAUSED",
        "EXECUTION_CAPACITY_REACHED",
        "MESSAGE_RATE_LIMITED",
        "ARTIFACT_QUOTA_EXCEEDED",
        "ARTIFACT_UPLOAD_OPEN",
        "ARTIFACT_INCOMPLETE",
        "ARTIFACT_DIGEST_MISMATCH",
        "ARTIFACT_UNAVAILABLE",
        "RUN_LEASE_STALE",
        "COORDINATOR_STALE",
        "CHECKOUT_OFFLINE",
        "PATH_FORBIDDEN",
        "SCOPE_STALE",
        "CONTENT_CONFLICT",
        "CONTEXT_STALE",
        "CHECKOUT_RECONCILIATION_REQUIRED",
        "PUBLICATION_PENDING",
        "FILE_NOT_FOUND",
        "NOT_FOUND"
      ]
    }
  }
}
