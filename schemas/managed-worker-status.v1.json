{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reply",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/ManagedWorkerStatus"
        }
      },
      "required": [
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError"
        }
      },
      "required": [
        "error"
      ]
    }
  ],
  "required": [
    "request_id",
    "timestamp"
  ],
  "$defs": {
    "ApiError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "current_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "BackendCost": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "meter": {
              "type": "string"
            },
            "quality": {
              "type": "string",
              "const": "reported"
            },
            "usd_micros": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "quality",
            "usd_micros",
            "meter"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pricing_revision": {
              "type": "string"
            },
            "quality": {
              "type": "string",
              "const": "estimated"
            },
            "usd_micros": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "quality",
            "usd_micros",
            "pricing_revision"
          ]
        }
      ]
    },
    "BackendEvidence": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "checkpoint_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "cost": {
          "description": "Absence means the provider cost is unknown, including subscription runs.",
          "anyOf": [
            {
              "$ref": "#/$defs/BackendCost"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "events_sha256": {
          "type": "string"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "terminal_state": {
          "$ref": "#/$defs/BackendState"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/BackendUsage"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "backend",
        "terminal_state",
        "event_count",
        "events_sha256"
      ]
    },
    "BackendState": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "input_required"
      ]
    },
    "BackendUsage": {
      "type": "object",
      "properties": {
        "cache_write_input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        },
        "input_tokens": {
          "description": "Total input, including tokens read from and written to the provider cache.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "description": "Total output, including reasoning tokens when the backend reports them.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reasoning_output_tokens": {
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "DATABASE_UNAVAILABLE",
        "INCOMPATIBLE_SCHEMA",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "INVALID_INPUT",
        "IDEMPOTENCY_CONFLICT",
        "REVISION_CONFLICT",
        "CURSOR_EXPIRED",
        "INVALID_TRANSITION",
        "DEPENDENCY_NOT_READY",
        "DEPENDENCY_CYCLE",
        "DELEGATION_CYCLE",
        "DELEGATION_LIMIT",
        "DELEGATION_INACTIVE",
        "CHECKOUT_ROOT_OVERLAP",
        "ACCESS_REQUEST_REQUIRED",
        "PATH_CLAIMED",
        "CLAIM_FENCE_STALE",
        "CLAIM_RENEWAL_LIMIT",
        "PATH_HANDOFF_PENDING",
        "BUDGET_EXHAUSTED",
        "EXECUTION_PAUSED",
        "EXECUTION_CAPACITY_REACHED",
        "MESSAGE_RATE_LIMITED",
        "ARTIFACT_QUOTA_EXCEEDED",
        "ARTIFACT_UPLOAD_OPEN",
        "ARTIFACT_INCOMPLETE",
        "ARTIFACT_DIGEST_MISMATCH",
        "ARTIFACT_UNAVAILABLE",
        "RUN_LEASE_STALE",
        "COORDINATOR_STALE",
        "CHECKOUT_OFFLINE",
        "PATH_FORBIDDEN",
        "SCOPE_STALE",
        "CONTENT_CONFLICT",
        "CONTEXT_STALE",
        "CHECKOUT_RECONCILIATION_REQUIRED",
        "PUBLICATION_PENDING",
        "FILE_NOT_FOUND",
        "NOT_FOUND"
      ]
    },
    "ExecutionJob": {
      "type": "object",
      "properties": {
        "checkout_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "current_run_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "enqueued_at": {
          "type": "string",
          "format": "date-time"
        },
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "managed_attempts": {
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        "owner_user_id": {
          "type": "string",
          "format": "uuid"
        },
        "reserved_units": {
          "type": "integer",
          "format": "int64"
        },
        "retry_not_before": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "runtime_template_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "scope_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "state": {
          "$ref": "#/$defs/ExecutionState"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "task_revision": {
          "type": "integer",
          "format": "int64"
        },
        "team_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "terminal_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionTerminalReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "worker_agent_id": {
          "type": "string",
          "format": "uuid"
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "job_id",
        "workspace_id",
        "task_id",
        "task_revision",
        "owner_user_id",
        "worker_agent_id",
        "runtime_template_id",
        "revision",
        "state",
        "reserved_units",
        "enqueued_at"
      ]
    },
    "ExecutionState": {
      "type": "string",
      "enum": [
        "queued",
        "leased",
        "reconcile_required",
        "cancelled",
        "dead_letter",
        "completed",
        "waiting_input",
        "resumed"
      ]
    },
    "ExecutionTerminalReason": {
      "type": "string",
      "enum": [
        "attempt_limit",
        "eligibility_changed",
        "start_interrupted",
        "execution_failed",
        "input_expired",
        "emergency_stopped",
        "restore_review_required"
      ]
    },
    "ManagedWorker": {
      "type": "object",
      "properties": {
        "lead": {
          "$ref": "#/$defs/Recipient"
        },
        "profile": {
          "$ref": "#/$defs/WorkerInstructions"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "worker": {
          "$ref": "#/$defs/Recipient"
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "workspace_id",
        "worker",
        "lead",
        "profile",
        "updated_at"
      ]
    },
    "ManagedWorkerStatus": {
      "type": "object",
      "properties": {
        "next_tasks_after": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManagedWorkerTask"
          }
        },
        "worker": {
          "$ref": "#/$defs/ManagedWorker"
        }
      },
      "required": [
        "worker",
        "tasks"
      ]
    },
    "ManagedWorkerTask": {
      "type": "object",
      "properties": {
        "job": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionJob"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/TaskView"
        }
      },
      "required": [
        "state"
      ]
    },
    "Recipient": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "user_id"
      ]
    },
    "ReviewPolicy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "accountable"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "explicit_reviewer"
            },
            "reviewer": {
              "$ref": "#/$defs/Recipient"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "reviewer"
          ]
        }
      ]
    },
    "Run": {
      "type": "object",
      "properties": {
        "attempt_number": {
          "type": "integer",
          "format": "int64"
        },
        "backend": {
          "anyOf": [
            {
              "$ref": "#/$defs/BackendEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "executor": {
          "$ref": "#/$defs/Recipient"
        },
        "instance_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "lease": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunLease"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "runtime_template_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "waiting_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "run_id",
        "task_id",
        "workspace_id",
        "attempt_number",
        "executor",
        "status",
        "started_at"
      ]
    },
    "RunLease": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "lease_until": {
          "type": "string",
          "format": "date-time"
        },
        "run_fence": {
          "type": "integer",
          "format": "int64"
        },
        "runner_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "job_id",
        "runner_id",
        "run_fence",
        "lease_until"
      ]
    },
    "RunStatus": {
      "type": "string",
      "enum": [
        "starting",
        "start_unknown",
        "running",
        "waiting_input",
        "paused",
        "succeeded",
        "failed",
        "cancel_requested",
        "cancelled",
        "lost",
        "unknown"
      ]
    },
    "Subject": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "human"
            },
            "user_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "user_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "type": "string",
              "const": "agent"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "agent_id"
          ]
        }
      ]
    },
    "Task": {
      "type": "object",
      "properties": {
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_criteria_revision": {
          "type": "integer",
          "format": "int64",
          "default": 1
        },
        "accountable": {
          "$ref": "#/$defs/Subject"
        },
        "assignee": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recipient"
            },
            {
              "type": "null"
            }
          ]
        },
        "author": {
          "$ref": "#/$defs/Subject"
        },
        "block_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskBlockReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "delegation_grant_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TaskDependency"
          }
        },
        "execution": {
          "$ref": "#/$defs/TaskExecution"
        },
        "objective": {
          "type": "string"
        },
        "owner_user_id": {
          "type": "string",
          "format": "uuid"
        },
        "parent_task_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "review_policy": {
          "$ref": "#/$defs/ReviewPolicy"
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "team_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "task_id",
        "workspace_id",
        "owner_user_id",
        "author",
        "accountable",
        "status",
        "revision",
        "objective",
        "acceptance_criteria",
        "execution",
        "review_policy",
        "dependencies",
        "created_at",
        "updated_at"
      ]
    },
    "TaskBlockReason": {
      "type": "string",
      "enum": [
        "awaiting_owner",
        "review_escalation"
      ]
    },
    "TaskDependency": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "task_id",
        "status"
      ]
    },
    "TaskExecution": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "coordination"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "checkout_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "kind": {
              "type": "string",
              "const": "coding"
            },
            "work_scope_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "work_scope_revision": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "assigned",
        "in_progress",
        "blocked",
        "in_review",
        "changes_requested",
        "done",
        "cancelled",
        "failed"
      ]
    },
    "TaskView": {
      "type": "object",
      "properties": {
        "next_run_after": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Run"
          }
        },
        "task": {
          "$ref": "#/$defs/Task"
        }
      },
      "required": [
        "task",
        "runs"
      ]
    },
    "WorkerInstructions": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "revision",
        "display_name",
        "instructions"
      ]
    }
  }
}
