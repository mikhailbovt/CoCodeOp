{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reply",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/ScopeRevocationReceipt"
        }
      },
      "required": [
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError"
        }
      },
      "required": [
        "error"
      ]
    }
  ],
  "required": [
    "request_id",
    "timestamp"
  ],
  "$defs": {
    "ApiError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "current_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "DATABASE_UNAVAILABLE",
        "INCOMPATIBLE_SCHEMA",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "INVALID_INPUT",
        "IDEMPOTENCY_CONFLICT",
        "REVISION_CONFLICT",
        "CURSOR_EXPIRED",
        "INVALID_TRANSITION",
        "DEPENDENCY_NOT_READY",
        "DEPENDENCY_CYCLE",
        "DELEGATION_CYCLE",
        "DELEGATION_LIMIT",
        "DELEGATION_INACTIVE",
        "CHECKOUT_ROOT_OVERLAP",
        "ACCESS_REQUEST_REQUIRED",
        "PATH_CLAIMED",
        "CLAIM_FENCE_STALE",
        "CLAIM_RENEWAL_LIMIT",
        "PATH_HANDOFF_PENDING",
        "BUDGET_EXHAUSTED",
        "EXECUTION_PAUSED",
        "EXECUTION_CAPACITY_REACHED",
        "MESSAGE_RATE_LIMITED",
        "ARTIFACT_QUOTA_EXCEEDED",
        "ARTIFACT_UPLOAD_OPEN",
        "ARTIFACT_INCOMPLETE",
        "ARTIFACT_DIGEST_MISMATCH",
        "ARTIFACT_UNAVAILABLE",
        "RUN_LEASE_STALE",
        "COORDINATOR_STALE",
        "CHECKOUT_OFFLINE",
        "PATH_FORBIDDEN",
        "SCOPE_STALE",
        "CONTENT_CONFLICT",
        "CONTEXT_STALE",
        "CHECKOUT_RECONCILIATION_REQUIRED",
        "PUBLICATION_PENDING",
        "FILE_NOT_FOUND",
        "NOT_FOUND"
      ]
    },
    "PathAccess": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PathRule"
          }
        },
        "deny": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PathRule"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "allow"
      ]
    },
    "PathRule": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "file"
            },
            "path": {
              "$ref": "#/$defs/SourcePath"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "directory"
            },
            "path": {
              "$ref": "#/$defs/SourcePath"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tree"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "Recipient": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "user_id"
      ]
    },
    "ScopeRevocationReceipt": {
      "type": "object",
      "properties": {
        "event_cursor": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "$ref": "#/$defs/WorkScope"
        }
      },
      "required": [
        "scope",
        "event_cursor"
      ]
    },
    "SourcePath": {
      "description": "A UTF-8, relative path in the managed source tree.",
      "type": "string"
    },
    "WorkPermissions": {
      "type": "object",
      "properties": {
        "change_executable": {
          "type": "boolean",
          "default": false
        },
        "command_template_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "create_directories": {
          "type": "boolean",
          "default": false
        },
        "read": {
          "$ref": "#/$defs/PathAccess"
        },
        "write": {
          "$ref": "#/$defs/PathAccess"
        },
        "write_operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WriteOperation"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "read",
        "write",
        "write_operations"
      ]
    },
    "WorkScope": {
      "type": "object",
      "properties": {
        "acknowledged_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "definition": {
          "$ref": "#/$defs/WorkScopeDefinition"
        },
        "policy_sequence": {
          "type": "integer",
          "format": "int64"
        },
        "state": {
          "$ref": "#/$defs/WorkScopeState"
        }
      },
      "required": [
        "definition",
        "state",
        "policy_sequence"
      ]
    },
    "WorkScopeDefinition": {
      "type": "object",
      "properties": {
        "access_request_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "checkout_id": {
          "type": "string",
          "format": "uuid"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "grant_id": {
          "type": "string",
          "format": "uuid"
        },
        "grant_revision": {
          "type": "integer",
          "format": "int64"
        },
        "operation": {
          "$ref": "#/$defs/WorkScopeOperation"
        },
        "permissions": {
          "$ref": "#/$defs/WorkPermissions"
        },
        "required_read_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourcePath"
          }
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "scope_id": {
          "type": "string",
          "format": "uuid"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "worker": {
          "$ref": "#/$defs/Recipient"
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "task_id",
        "checkout_id",
        "grant_id",
        "grant_revision",
        "scope_id",
        "revision",
        "worker",
        "expires_at",
        "permissions"
      ]
    },
    "WorkScopeOperation": {
      "type": "string",
      "enum": [
        "apply",
        "revoke"
      ]
    },
    "WorkScopeState": {
      "type": "string",
      "enum": [
        "pending_activation",
        "active",
        "superseded",
        "rejected",
        "revocation_pending",
        "revoked"
      ]
    },
    "WriteOperation": {
      "type": "string",
      "enum": [
        "create",
        "replace",
        "delete",
        "rename"
      ]
    }
  }
}
