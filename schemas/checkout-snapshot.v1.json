{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reply",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/CheckoutSnapshot"
        }
      },
      "required": [
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError"
        }
      },
      "required": [
        "error"
      ]
    }
  ],
  "required": [
    "request_id",
    "timestamp"
  ],
  "$defs": {
    "ApiError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "current_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "CheckoutContentHead": {
      "type": "object",
      "properties": {
        "checkout_revision": {
          "type": "integer",
          "format": "int64"
        },
        "source_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "checkout_revision",
        "source_sha256"
      ]
    },
    "CheckoutSnapshot": {
      "type": "object",
      "properties": {
        "checkout_id": {
          "type": "string",
          "format": "uuid"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "head": {
          "$ref": "#/$defs/CheckoutContentHead"
        },
        "host_runner_id": {
          "type": "string",
          "format": "uuid"
        },
        "proof": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckoutSnapshotProof"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "$ref": "#/$defs/CheckoutSnapshotState"
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "workspace_id",
        "checkout_id",
        "snapshot_id",
        "host_runner_id",
        "head",
        "state",
        "created_at"
      ]
    },
    "CheckoutSnapshotProof": {
      "type": "object",
      "properties": {
        "baseline": {
          "$ref": "#/$defs/SourceBaseline"
        },
        "git_commit_sha256": {
          "type": "string"
        },
        "git_tree_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "baseline",
        "git_tree_sha256",
        "git_commit_sha256"
      ]
    },
    "CheckoutSnapshotState": {
      "type": "string",
      "enum": [
        "queued",
        "ready",
        "source_changed",
        "storage_unavailable",
        "expired"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "DATABASE_UNAVAILABLE",
        "INCOMPATIBLE_SCHEMA",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "INVALID_INPUT",
        "IDEMPOTENCY_CONFLICT",
        "REVISION_CONFLICT",
        "CURSOR_EXPIRED",
        "INVALID_TRANSITION",
        "DEPENDENCY_NOT_READY",
        "DEPENDENCY_CYCLE",
        "DELEGATION_CYCLE",
        "DELEGATION_LIMIT",
        "DELEGATION_INACTIVE",
        "CHECKOUT_ROOT_OVERLAP",
        "ACCESS_REQUEST_REQUIRED",
        "PATH_CLAIMED",
        "CLAIM_FENCE_STALE",
        "CLAIM_RENEWAL_LIMIT",
        "PATH_HANDOFF_PENDING",
        "BUDGET_EXHAUSTED",
        "EXECUTION_PAUSED",
        "EXECUTION_CAPACITY_REACHED",
        "MESSAGE_RATE_LIMITED",
        "ARTIFACT_QUOTA_EXCEEDED",
        "ARTIFACT_UPLOAD_OPEN",
        "ARTIFACT_INCOMPLETE",
        "ARTIFACT_DIGEST_MISMATCH",
        "ARTIFACT_UNAVAILABLE",
        "RUN_LEASE_STALE",
        "COORDINATOR_STALE",
        "CHECKOUT_OFFLINE",
        "PATH_FORBIDDEN",
        "SCOPE_STALE",
        "CONTENT_CONFLICT",
        "CONTEXT_STALE",
        "CHECKOUT_RECONCILIATION_REQUIRED",
        "PUBLICATION_PENDING",
        "FILE_NOT_FOUND",
        "NOT_FOUND"
      ]
    },
    "SourceBaseline": {
      "type": "object",
      "properties": {
        "file_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "manifest_sha256": {
          "type": "string"
        },
        "total_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "file_count",
        "total_bytes"
      ]
    }
  }
}
