{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reply",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/ActivationPolicy"
        }
      },
      "required": [
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError"
        }
      },
      "required": [
        "error"
      ]
    }
  ],
  "required": [
    "request_id",
    "timestamp"
  ],
  "$defs": {
    "ActivationPolicy": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string",
          "format": "uuid"
        },
        "managed": {
          "anyOf": [
            {
              "$ref": "#/$defs/ManagedActivation"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "workspace_id",
        "agent_id",
        "revision"
      ]
    },
    "ActivationTrigger": {
      "type": "string",
      "enum": [
        "assignment",
        "question",
        "review_request",
        "answer"
      ]
    },
    "ApiError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "current_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "DATABASE_UNAVAILABLE",
        "INCOMPATIBLE_SCHEMA",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "INVALID_INPUT",
        "IDEMPOTENCY_CONFLICT",
        "REVISION_CONFLICT",
        "CURSOR_EXPIRED",
        "INVALID_TRANSITION",
        "DEPENDENCY_NOT_READY",
        "DEPENDENCY_CYCLE",
        "DELEGATION_CYCLE",
        "DELEGATION_LIMIT",
        "DELEGATION_INACTIVE",
        "CHECKOUT_ROOT_OVERLAP",
        "ACCESS_REQUEST_REQUIRED",
        "PATH_CLAIMED",
        "CLAIM_FENCE_STALE",
        "CLAIM_RENEWAL_LIMIT",
        "PATH_HANDOFF_PENDING",
        "BUDGET_EXHAUSTED",
        "EXECUTION_PAUSED",
        "EXECUTION_CAPACITY_REACHED",
        "MESSAGE_RATE_LIMITED",
        "ARTIFACT_QUOTA_EXCEEDED",
        "ARTIFACT_UPLOAD_OPEN",
        "ARTIFACT_INCOMPLETE",
        "ARTIFACT_DIGEST_MISMATCH",
        "ARTIFACT_UNAVAILABLE",
        "RUN_LEASE_STALE",
        "COORDINATOR_STALE",
        "CHECKOUT_OFFLINE",
        "PATH_FORBIDDEN",
        "SCOPE_STALE",
        "CONTENT_CONFLICT",
        "CONTEXT_STALE",
        "CHECKOUT_RECONCILIATION_REQUIRED",
        "PUBLICATION_PENDING",
        "FILE_NOT_FOUND",
        "NOT_FOUND"
      ]
    },
    "ManagedActivation": {
      "type": "object",
      "properties": {
        "cooldown_seconds": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "debounce_seconds": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "max_turns_per_hour": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "max_turns_per_thread": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "runner_id": {
          "type": "string",
          "format": "uuid"
        },
        "runtime_template_id": {
          "type": "string",
          "format": "uuid"
        },
        "triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActivationTrigger"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "runner_id",
        "runtime_template_id",
        "triggers",
        "debounce_seconds",
        "cooldown_seconds",
        "max_turns_per_thread",
        "max_turns_per_hour"
      ]
    }
  }
}
